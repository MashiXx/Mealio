// Mealio — Prisma schema
// Multi-tenant: mọi model nghiệp vụ gắn familyId và luôn được scope theo gia đình
// của user đăng nhập (xem src/lib/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Auth.js (NextAuth) — credentials + JWT; Account/Session để dành cho
// OAuth về sau. PrismaAdapter dùng các model này.
// ------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  image        String?
  createdAt    DateTime @default(now())

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------------
// Tenant: Family + hồ sơ ăn uống
// ------------------------------------------------------------------

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  members        FamilyMember[]
  profile        EatingProfile?
  aiSettings     AISettings?
  ingredients    Ingredient[]    @relation("FamilyIngredients")
  pantryItems    PantryItem[]
  recipes        Recipe[]
  mealPlans      MealPlan[]
  plannedMeals   PlannedMeal[]
  shoppingLists  ShoppingList[]
  generationJobs GenerationJob[]
  editJobs       EditJob[]
}

model FamilyMember {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  name                String
  image               String? // đường dẫn avatar (vd: /uploads/<uuid>.jpg)
  ageGroup            AgeGroup @default(ADULT)
  allergies           String[] @default([])
  dietaryRestrictions String[] @default([])
  likes               String[] @default([])
  dislikes            String[] @default([])

  @@index([familyId])
}

enum AgeGroup {
  BABY
  CHILD
  TEEN
  ADULT
  SENIOR
}

model EatingProfile {
  id       String @id @default(cuid())
  familyId String @unique
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  cuisineRegion  CuisineRegion @default(MIEN_BAC)
  spiceLevel     SpiceLevel    @default(MEDIUM)
  budgetLevel    BudgetLevel   @default(MEDIUM)
  maxCookMinutes Int           @default(60)
  healthGoals    String[]      @default([]) // nhãn định tính: nhiều rau, ít dầu mỡ...
  notes          String?
}

enum CuisineRegion {
  MIEN_BAC
  MIEN_TRUNG
  MIEN_NAM
  KHONG_CO_KHAU_VI // linh hoạt
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
}

// ------------------------------------------------------------------
// AI settings (BYOK) — key mã hoá, chỉ giải mã ở server
// ------------------------------------------------------------------

model AISettings {
  id       String @id @default(cuid())
  familyId String @unique
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  provider           AIProvider @default(ANTHROPIC)
  baseUrl            String?
  apiKeyEncrypted    String?
  basicAuthEncrypted String?
  model              String     @default("claude-opus-4-8")
  updatedAt          DateTime   @updatedAt
}

enum AIProvider {
  ANTHROPIC
  OPENAI_COMPATIBLE
  OLLAMA
}

// ------------------------------------------------------------------
// Nguyên liệu chuẩn hoá + kho thực phẩm
// ------------------------------------------------------------------

model Ingredient {
  id          String         @id @default(cuid())
  familyId    String
  family      Family         @relation("FamilyIngredients", fields: [familyId], references: [id], onDelete: Cascade)
  name        String
  normalized  String // tên chuẩn hoá (lowercase, bỏ dấu) để match
  defaultUnit String         @default("phần")
  kind        IngredientKind @default(MAIN)

  pantryItems       PantryItem[]
  recipeIngredients RecipeIngredient[]
  shoppingItems     ShoppingItem[]

  @@unique([familyId, normalized])
  @@index([familyId])
}

model PantryItem {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  // Kho là danh sách "có/không", không định lượng -> mỗi nguyên liệu đúng một dòng.
  @@unique([familyId, ingredientId])
  @@index([familyId])
}

// ------------------------------------------------------------------
// Công thức (kho riêng của gia đình)
// ------------------------------------------------------------------

model Recipe {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  name            String
  source          RecipeSource @default(AI)
  servings        Int          @default(4)
  cookMinutes     Int          @default(30)
  steps           String[]     @default([])
  nutritionLabels String[]     @default([]) // nhiều rau, ít dầu mỡ, thanh đạm...
  createdAt       DateTime     @default(now())

  ingredients RecipeIngredient[]
  mealDishes  MealDish[]

  @@index([familyId])
}

enum RecipeSource {
  AI
  MANUAL
}

// Một cờ quyết định ba hành vi: MAIN thì bị verify theo kho, vào danh sách đi chợ
// và rời kho sau khi nấu; SEASONING thì bỏ qua cả ba (coi như bếp luôn có).
enum IngredientKind {
  MAIN
  SEASONING
}

// Chế độ sinh thực đơn: kho là danh sách trắng (AVAILABLE_ONLY) hay chỉ là gợi ý
// ưu tiên, thiếu gì thì đi chợ (FLEXIBLE).
enum PantryMode {
  AVAILABLE_ONLY
  FLEXIBLE
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  quantity Float  @default(1)
  unit     String @default("phần")

  @@index([recipeId])
}

// ------------------------------------------------------------------
// Kế hoạch bữa ăn (ngày/tuần)
// ------------------------------------------------------------------

model MealPlan {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  meals PlannedMeal[]

  @@index([familyId])
}

model PlannedMeal {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  mealPlanId String?
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)

  date     DateTime
  mealType MealType
  servings Int       @default(4) // số người ăn bữa này
  cookedAt DateTime? // đã nấu lúc nào; null = chưa nấu

  dishes      MealDish[]
  editJobs    EditJob[]
  chatHistory Json          @default("[]") // lịch sử chat cấp mâm: [{role, content}]

  @@unique([familyId, date, mealType])
  @@index([familyId, date])
}

model MealDish {
  id            String      @id @default(cuid())
  plannedMealId String
  plannedMeal   PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  dishRole    DishRole @default(MON_MAN)
  position    Int      @default(0)
  chatHistory Json     @default("[]") // lịch sử chat của món: [{role, content}]

  @@index([plannedMealId])
}

model EditJob {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  plannedMealId String
  plannedMeal   PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)

  scope       EditScope
  mealDishId  String? // món đích khi scope=DISH
  instruction String
  useHistory  Boolean @default(false)

  status     JobStatus @default(PENDING)
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([familyId, status])
  @@index([plannedMealId])
}

enum EditScope {
  DISH
  MEAL
  ADD
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

// ------------------------------------------------------------------
// Danh sách đi chợ
// ------------------------------------------------------------------

model ShoppingList {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt DateTime       @default(now())
  closedAt  DateTime? // đã đi chợ xong lúc nào; null = danh sách đang mở
  items     ShoppingItem[]

  @@index([familyId])
}

model ShoppingItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  quantity  Float   @default(1)
  unit      String  @default("phần")
  purchased Boolean @default(false)

  @@index([shoppingListId])
}

// ------------------------------------------------------------------
// Job tạo thực đơn chạy ngầm
// ------------------------------------------------------------------

model GenerationJob {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  date       DateTime // ngày mục tiêu (midnight)
  mealTypes  MealType[] // các bữa cần tạo
  status     JobStatus  @default(PENDING)
  error      String? // lý do nếu FAILED
  dishCount  Int? // số món/bữa chính người dùng chọn; null = tự động
  pantryMode PantryMode @default(FLEXIBLE) // chế độ dùng kho khi sinh thực đơn

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([familyId, status])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ------------------------------------------------------------------
// Kho món ăn dùng chung (catalog) — TOÀN CỤC, không gắn familyId.
// Nguồn chân lý là src/data/catalog/*; DB được seed từ đó (prisma/seed.ts).
// Dùng để gợi ý/lọc món cho mọi gia đình và tham chiếu cho AI.
// ------------------------------------------------------------------

model CatalogDish {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  aliases String[] @default([])

  dishRole    DishRole
  region      CuisineRegion @default(KHONG_CO_KHAU_VI)
  mealTypes   MealType[]    @default([])
  servings    Int           @default(4)
  cookMinutes Int           @default(30)
  difficulty  Difficulty    @default(EASY)
  budgetLevel BudgetLevel   @default(MEDIUM)

  steps           String[] @default([])
  // [{ name, quantity, unit }] — không nối Ingredient per-family (dữ liệu dùng chung).
  ingredients     Json
  nutritionLabels String[] @default([])
  // nhãn lọc an toàn/khẩu vị: chua-hai-san, chua-dau-phong, chay...
  tags            String[] @default([])
  notes           String?

  imageUrl    String? // đường dẫn nội bộ, vd /dishes/thit-kho-tau.jpg
  imageCredit String? // ghi công nguồn ảnh + giấy phép

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setMenuItems CatalogSetMenuItem[]

  @@index([dishRole])
  @@index([region])
}

enum DishRole {
  MON_MAN // kho, rán, nướng, hấp (đạm chính)
  MON_XAO // xào
  CANH_SUP // canh, súp, riêu
  RAU_LUOC // rau luộc, nộm/gỏi, salad
  LAU // lẩu
  COM_BUN_PHO // cơm, bún, phở, xôi, mì, cháo
  MON_CUON // các món cuốn
  TRANG_MIENG // tráng miệng, chè, trái cây
  DO_CHUA // dưa, cà, đồ chua ăn kèm
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CatalogSetMenu {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  occasion  String // com-ngay-thuong, cuoi-tuan, dai-khach, chay, tet...
  region    CuisineRegion @default(KHONG_CO_KHAU_VI)
  servings  Int           @default(4)
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items CatalogSetMenuItem[]
}

model CatalogSetMenuItem {
  id        String         @id @default(cuid())
  setMenuId String
  setMenu   CatalogSetMenu @relation(fields: [setMenuId], references: [id], onDelete: Cascade)

  dishId String
  dish   CatalogDish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  position Int @default(0) // thứ tự món trong mâm

  @@unique([setMenuId, dishId])
  @@index([setMenuId])
  @@index([dishId])
}
